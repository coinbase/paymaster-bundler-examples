# Required — no hardcoded production default
ALERT_WEBHOOK_URL=https://my-onchainkit-app.vercel.app/api/webhooks/tradingview
TRADINGVIEW_WEBHOOK_SECRET=

# price-alerts poll interval (ms)
ALERT_POLL_MS=60000

# --- email-bridge (TradingView free email alerts) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# Gmail: App Password (not your normal password)
IMAP_PASS=
IMAP_MAILBOX=INBOX
TV_EMAIL_FROM=tradingview.com
EMAIL_POLL_MS=30000
# Require DKIM pass in Authentication-Results (recommended)
REQUIRE_TV_DKIM=true
